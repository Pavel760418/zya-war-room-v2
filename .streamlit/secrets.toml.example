# Пример секретов для Streamlit Cloud / локального `.streamlit/secrets.toml`.
# Скопируйте в Settings → Secrets (Cloud) или в `.streamlit/secrets.toml` (локально).
# НИКОГДА не коммитьте реальные пароли в публичный репозиторий.

# ---------------------------------------------------------------------------
# Рекомендуется для Streamlit Cloud: LAN SQL gateway (публичный HTTP edge)
# ---------------------------------------------------------------------------
WARROOM_GATEWAY_URL = "http://81.163.35.181:3000/warroom-api"
WARROOM_GATEWAY_TOKEN = "paste-token-from-server-gateway.env"
# На Cloud не используем локальный SQLite-кэш сервера офиса:
WARROOM_DATA_SOURCE = "sql"

# ---------------------------------------------------------------------------
# Прямое MSSQL (только если хост маршрутизируется из Cloud — обычно нет для 192.168.x.x)
# ---------------------------------------------------------------------------
# DATABASE_URL = "mssql+pymssql://USER:PASSWORD@HOST:1433/DATABASE"
# DB_HOST = "192.168.2.10"
# DB_PORT = "1433"
# DB_NAME = "retail"
# DB_USER = "readonly_warroom"
# DB_PASSWORD = "change-me"

# DATA_SOURCE_MODE = "mssql"
# WARROOM_SQL_TIMEOUT = "60"
# WARROOM_SQL_RETRIES = "4"
