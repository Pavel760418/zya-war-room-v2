# Пример секретов для Streamlit Cloud / локального `.streamlit/secrets.toml`.
# Скопируйте в Settings → Secrets (Cloud) или в `.streamlit/secrets.toml` (локально).
# НИКОГДА не коммитьте реальные пароли.

# ---------------------------------------------------------------------------
# Вариант A — одна строка подключения (предпочтительно)
# ---------------------------------------------------------------------------
DATABASE_URL = "mssql+pymssql://USER:PASSWORD@HOST:1433/DATABASE"

# ---------------------------------------------------------------------------
# Вариант B — отдельные ключи (если удобнее в UI Secrets)
# ---------------------------------------------------------------------------
# DB_HOST = "192.168.2.10"          # хост SQL Server 1С (LAN или VPN)
# DB_PORT = "1433"                  # порт TDS
# DB_NAME = "retail"                # имя базы
# DB_USER = "readonly_warroom"      # пользователь только SELECT
# DB_PASSWORD = "change-me"         # пароль

# ---------------------------------------------------------------------------
# Опционально
# ---------------------------------------------------------------------------
# DATA_SOURCE_MODE = "mssql"        # продуктовый путь всегда SQL
# WARROOM_SQL_TIMEOUT = "60"        # секунды на connect/query

# ---------------------------------------------------------------------------
# Альтернатива: вложенный блок [database]
# ---------------------------------------------------------------------------
# [database]
# url = "mssql+pymssql://USER:PASSWORD@HOST:1433/DATABASE"
# # либо:
# # host = "192.168.2.10"
# # port = "1433"
# # name = "retail"
# # user = "readonly_warroom"
# # password = "change-me"
