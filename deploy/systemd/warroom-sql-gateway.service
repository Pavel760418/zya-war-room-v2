[Unit]
Description=War Room SQL Gateway (1C MSSQL → JSON for Streamlit Cloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/andr/apps/zya-war-room-v2
EnvironmentFile=-/home/andr/.config/warroom/warroom.env
EnvironmentFile=-/home/andr/.config/warroom/gateway.env
Environment=PYTHONPATH=/home/andr/apps/zya-war-room-v2
Environment=WARROOM_GATEWAY_HOST=127.0.0.1
Environment=WARROOM_GATEWAY_PORT=8520
Environment=WARROOM_GATEWAY_LOG_DIR=/home/andr/apps/zya-war-room-v2/var/log
ExecStart=/home/andr/apps/zya-war-room-v2/.venv/bin/python /home/andr/apps/zya-war-room-v2/scripts/warroom_sql_gateway.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
