[Unit]
Description=МегаМетрики — расписание синхронизации кэша (08:00 и 12:00 МСК)
Requires=warroom-sync.service

[Timer]
# Московское время (Europe/Moscow = UTC+3)
OnCalendar=*-*-* 08:00:00 Europe/Moscow
OnCalendar=*-*-* 12:00:00 Europe/Moscow
Persistent=true
Unit=warroom-sync.service

[Install]
WantedBy=timers.target
