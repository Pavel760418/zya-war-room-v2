[Unit]
Description=ZYA War Room Streamlit
After=network.target

[Service]
Type=simple
User=andr
Group=andr
WorkingDirectory=/home/andr/apps/zya-war-room-v2
EnvironmentFile=/home/andr/.config/warroom/warroom.env
# User unit (recommended): ~/.config/systemd/user/warroom-streamlit.service
# LAN URL: http://<host>:8501 via warroom-proxy (allowlist) → 127.0.0.1:8502
ExecStart=/home/andr/apps/zya-war-room-v2/.venv/bin/streamlit run streamlit_app.py --server.port 8502 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5
# Hardening (no secrets in unit file)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
